<launch>
    <!--
      Pinned upstream OpenVINS KAIST system arm for the diagnostic G0.5 screen.
      This file changes transport and evidence bindings only. Estimator and
      frontend defaults remain in upstream config/kaist_vio.
    -->
    <arg name="config_path" />
    <arg name="bag" />
    <arg name="bag_start" default="0.0" />
    <arg name="bag_durr" default="-1.0" />
    <arg name="path_state" />
    <arg name="path_std" />
    <arg name="path_time" />
    <arg name="record_timing" default="true" />

    <node name="icra27_kaist_u0" pkg="ov_msckf"
          type="ros1_serial_msckf" output="screen" clear_params="true"
          required="true">
        <param name="config_path" type="str" value="$(arg config_path)" />
        <param name="path_bag" type="str" value="$(arg bag)" />
        <param name="bag_start" type="double" value="$(arg bag_start)" />
        <param name="bag_durr" type="double" value="$(arg bag_durr)" />
        <!-- Unavoidable bindings to the unchanged adapted-bag topics. -->
        <param name="cam0_rostopic" type="str"
               value="/turnsafe/kaist/infra1/image_raw" />
        <param name="cam1_rostopic" type="str"
               value="/turnsafe/kaist/infra2/image_raw" />
        <param name="imu0_rostopic" type="str" value="/mavros/imu/data" />

        <!-- Passive evidence outputs; no ground-truth path is supplied. -->
        <param name="save_total_state" type="bool" value="true" />
        <param name="filepath_est" type="str" value="$(arg path_state)" />
        <param name="filepath_std" type="str" value="$(arg path_std)" />
        <param name="record_timing_information" type="bool"
               value="$(arg record_timing)" />
        <param name="record_timing_filepath" type="str"
               value="$(arg path_time)" />
    </node>
</launch>
